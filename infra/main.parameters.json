{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "searchLocation": {
      "value": "${AZURE_SEARCH_LOCATION=centralus}"
    },
    "apimPublisherEmail": {
      "value": "${APIM_PUBLISHER_EMAIL=demo@contoso-energy.example}"
    },
    "backendImage": {
      "value": "${SERVICE_BACKEND_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "frontendImage": {
      "value": "${SERVICE_FRONTEND_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    }
  }
}
