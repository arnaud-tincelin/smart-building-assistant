<policies>
    <inbound>
        <base />
        <!-- Authenticate to Azure OpenAI with APIM's managed identity (no keys). -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="msi-access-token" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
        </set-header>
        <!-- Token-based rate limiting across callers (AI Gateway). -->
        <azure-openai-token-limit counter-key="@(context.Subscription?.Id ?? "anonymous")" tokens-per-minute="10000" estimate-prompt-tokens="true" remaining-tokens-header-name="x-ratelimit-remaining-tokens" tokens-consumed-header-name="x-ratelimit-consumed-tokens" />
        <!-- Emit token usage metrics for observability. -->
        <azure-openai-emit-token-metric namespace="buildingassist">
            <dimension name="API ID" />
        </azure-openai-emit-token-metric>
    </inbound>
    <backend>
        <!-- Retry transient upstream failures (AI Gateway resilience). -->
        <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="2" first-fast-retry="true">
            <forward-request buffer-request-body="true" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
