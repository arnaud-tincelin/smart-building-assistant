# Example environment for local backend runs.
# Copy to `.env` and fill in, or set BUILDINGASSIST_USE_MOCK_AGENT=true to run offline.

# Foundry project endpoint, e.g.
# https://<account>.services.ai.azure.com/api/projects/<project>
BUILDINGASSIST_PROJECT_ENDPOINT=

# Microsoft Foundry model deployment used by Responses API calls.
BUILDINGASSIST_MODEL_DEPLOYMENT=model-router

# Provisioned prompt agent. Set empty to compose direct Responses tools instead.
BUILDINGASSIST_AGENT_NAME=buildingassist-agent

# Azure AI Search Knowledge Base MCP endpoint (preferred production grounding).
BUILDINGASSIST_KNOWLEDGE_MCP_ENDPOINT=

# Public Streamable HTTP MCP endpoint. A localhost URL cannot be reached by Foundry.
BUILDINGASSIST_MCP_SERVER_URL=

# User-assigned managed identity client id (leave blank locally).
BUILDINGASSIST_AZURE_CLIENT_ID=

# Comma-separated allowed CORS origins (frontend). "*" for local dev.
BUILDINGASSIST_ALLOWED_ORIGINS=*

# Set to true to bypass Azure and return a canned answer.
BUILDINGASSIST_USE_MOCK_AGENT=true

# Enable client-side OpenTelemetry export when Application Insights is configured.
BUILDINGASSIST_ENABLE_TRACING=false
